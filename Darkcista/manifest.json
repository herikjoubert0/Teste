{
  "manifest_version": 3,
  "name": "Darkcista",
  "version": "1.0.5",
  "description": "Ferramentas de automação para Google Flow",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://labs.google.com/*",
    "https://fixa.tech/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Darkcista — clique para forçar a ativação nesta aba"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google/*", "https://*.flow.google/*", "https://flow.google.com/*", "https://*.flow.google.com/*", "https://labs.google/*", "https://labs.google.com/*"],
      "js": ["cd_download_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://flow.google/*", "https://*.flow.google/*", "https://flow.google.com/*", "https://*.flow.google.com/*", "https://labs.google/*", "https://labs.google.com/*"],
      "js": ["cd_download_bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
